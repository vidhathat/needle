{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-output",
  "framework": null,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/download/",
      "destination": "https://9rt8zr04msyyegmt.public.blob.vercel-storage.com/updates/mac/Needle-latest-arm64.dmg"
    }
  ],
  "headers": [
    {
      "source": "/download/",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Needle.dmg\""
        }
      ]
    }
  ]
}
